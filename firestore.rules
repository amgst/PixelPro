rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin is identified by a custom claim set via the Firebase Admin SDK.
    // Set this once on the admin user (see deployment notes). Until the claim
    // is set, no client will be able to write to protected collections.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ---------------------------------------------------------------------
    // Public content collections
    // Readable by everyone, writable only by an admin.
    // ---------------------------------------------------------------------
    match /blog_posts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /service_categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /readySites/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portfolios/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tools/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings (e.g. settings/general)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Submission collections
    // Anyone can create (public forms), only an admin can read/manage.
    // ---------------------------------------------------------------------
    match /project_inquiries/{docId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.serviceType is string;
      allow read, update, delete: if isAdmin();
    }

    match /contact_messages/{docId} {
      allow create: if request.resource.data.firstName is string
                    && request.resource.data.lastName is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string;
      allow read, update, delete: if isAdmin();
    }

    match /job_applications/{docId} {
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.email is string
                    && request.resource.data.role is string;
      allow read, update, delete: if isAdmin();
    }

    match /store_orders/{docId} {
      allow create: if request.resource.data.customerName is string
                    && request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Default deny everything else.
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
