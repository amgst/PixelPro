rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Admin is identified by a custom claim set via the Firebase Admin SDK.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Uploaded assets (product images, settings logos/favicons, ready-site
    // images, etc.) are public to read. Writes are restricted to admins and
    // limited to images under 5MB. All client uploads in this app are admin
    // driven, so a single rule keeps every upload path covered.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
